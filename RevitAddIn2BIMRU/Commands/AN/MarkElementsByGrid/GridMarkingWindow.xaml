<Window x:Class="RevitAddIn2BIMRU.Commands.AN.GridMarkingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RevitAddIn2BIMRU.Commands.AN"
        mc:Ignorable="d"
        Title="Маркировка элементов по координатам X-Y" 
        Height="500" 
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="WhiteSmoke">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#e95960" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <TextBlock Text="Маркировка элементов " 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Выбор параметра -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Параметр для маркировки:" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="txtParameterName"
                     Text="ADSK_Позиция"
                     Width="250"
                     HorizontalAlignment="Left"
                     Padding="5"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     ToolTip="Введите имя параметра, в который будет записан номер"
                     TextChanged="TxtParameterName_TextChanged"/>

            <TextBlock Text="Подсказка: ADSK_Позиция, ADSK_Марка, ADSK_Номер, Марка, Обозначение, Позиция"
                       FontStyle="Italic"
                       FontSize="11"
                       Foreground="Gray"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Начальный номер -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Начинаем маркировать с:" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="txtStartNumber" 
                     Text="1" 
                     Width="100" 
                     HorizontalAlignment="Left"
                     Padding="5"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     PreviewTextInput="TxtStartNumber_PreviewTextInput"
                     TextChanged="TxtStartNumber_TextChanged"/>
        </StackPanel>

        <!-- Направление по X -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Направление по оси X:" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="rbXLeftToRight" 
                            Content="Слева направо" 
                            Margin="0,5,20,5" 
                            IsChecked="True"
                            GroupName="XDirection"
                            Checked="RadioButton_Checked"/>

                <RadioButton x:Name="rbXRightToLeft" 
                            Content="Справа налево" 
                            Margin="0,5"
                            GroupName="XDirection"
                            Checked="RadioButton_Checked"/>
            </StackPanel>
        </StackPanel>

        <!-- Направление по Y -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Направление по оси Y:" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="rbYBottomToTop" 
                            Content="Снизу вверх" 
                            Margin="0,5,20,5" 
                            IsChecked="True"
                            GroupName="YDirection"
                            Checked="RadioButton_Checked"/>

                <RadioButton x:Name="rbYTopToBottom" 
                            Content="Сверху вниз" 
                            Margin="0,5"
                            GroupName="YDirection"
                            Checked="RadioButton_Checked"/>
            </StackPanel>
        </StackPanel>

        <!-- Режим маркировки -->
        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="Режим маркировки:" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <StackPanel>
                <RadioButton x:Name="rbByRows" 
                            Content="По строкам (сначала Y, затем X)" 
                            Margin="0,5" 
                            IsChecked="True"
                            GroupName="MarkingMode"
                            Checked="RadioButton_Checked"/>

                <RadioButton x:Name="rbContinuous" 
                            Content="Непрерывно по X (сначала X, затем Y)" 
                            Margin="0,5"
                            GroupName="MarkingMode"
                            Checked="RadioButton_Checked"/>
            </StackPanel>
        </StackPanel>

        <!-- Информация -->
        <Border Grid.Row="6" 
                Background="#FFF0F0F0" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1"
                CornerRadius="3"
                Padding="10"
                Margin="0,0,0,10">
            <TextBlock x:Name="txtInfo" 
                       Text=""
                       TextWrapping="Wrap"
                       FontStyle="Italic"/>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="7" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="btnOk" 
                    Content="ОК" 
                    Width="80" 
                    Height="35" 
                    Margin="0,0,10,0" 
                    Background="#e95960"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="BtnOk_Click"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="btnCancel" 
                    Content="Отмена" 
                    Width="80" 
                    Height="35" 
                    Background="#E0E0E0"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="BtnCancel_Click"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>