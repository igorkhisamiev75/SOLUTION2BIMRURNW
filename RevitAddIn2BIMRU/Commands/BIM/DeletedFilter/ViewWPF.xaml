<Window x:Class="RevitAddIn2BIMRU.Commands.BIM.ViewWPF"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RevitAddIn2BIMRU.Commands.BIM"
             mc:Ignorable="d" 
             Title="Удалить фильтры"
             Height="500" Width="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.2*"/>
        </Grid.ColumnDefinitions>
        <Button Content="OK" 
                HorizontalAlignment="Left" 
                Margin="0,10,0,0" 
                VerticalAlignment="Top" 
                Width="75" Height="21" 
                Grid.Column="1" Click="Button_Click"/>
        <Button Content="CANCEL" 
                HorizontalAlignment="Left" 
                Margin="0,36,0,0" 
                VerticalAlignment="Top" Width="75" 
                Grid.Column="1" Height="21" Click="Button_Click_1"/>
        
        <ListBox 
            Name="ListBox"
            HorizontalContentAlignment="Stretch"
            HorizontalAlignment="Stretch" 
            Margin="10,10,10,10" 
            VerticalAlignment="Stretch" 
            SelectionMode="Extended"
            />
   </Grid>
</Window>
