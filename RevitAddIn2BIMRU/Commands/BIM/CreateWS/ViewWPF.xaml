<Window x:Class="RevitAddIn2BIMRU.Commands.BIM.CreateWS.ViewWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:RevitAddIn2BIMRU.Commands.BIM.CreateWS"
        mc:Ignorable="d" 
        Title="Add Worksets"
        Height="228.571" Width="500">
    <Grid Margin="0,0,-5.714,12.429">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.2*"/>
        </Grid.ColumnDefinitions>
        <Button Content="OK" 
                HorizontalAlignment="Left" 
                Margin="0,10,0,0" 
                VerticalAlignment="Top" 
                Width="75" Height="21" 
                Grid.Column="1" Click="Button_Click"/>
