                HorizontalAlignment="Left" 
                Margin="0,36,0,0" 
                VerticalAlignment="Top" Width="75" 
                Grid.Column="1" Height="21" Click="Button_Click_1"/>
        <RichTextBox 
                     Name="RichTextBox"
                     HorizontalAlignment="Left" 
                     Height="158" 
                     Margin="10,10,0,0" 
                     VerticalAlignment="Top" 
                     Width="392">
            <FlowDocument>
                <Paragraph>
                    <Run Text="00_Общие_уровни_и_оси 00_Рабочий_набор_1 01_Генплан 02_Архитектура 03_Конструкции 04_Электроснабжение 05.1_Водоснабжение 05.2_Канализация 06.1_Отопление 06.2_Вентиляция 06.3_Кондиционирование 92_Связь_AR 93_Связь_SC 94_Связь_MEP-HVAC 94_Связь_MEP-ESS 94_Связь_MEP-WSS"/>
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
    </Grid>
</Window>
